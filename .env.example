# ─────────────────────────────────────────────────────────────
# CampusLens Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local Docker (docker-compose.yml):
#   DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campuslens"
# Neon (recommended for Vercel — copy the pooled connection string):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/campuslens"

# JWT signing secret. Generate with:
#   openssl rand -base64 32     (or)   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST be at least 32 characters. MUST be unique per environment.
AUTH_SECRET=""

# Public app URL (used for metadata/OG tags)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo accounts (student@campuslens.edu / admin@campuslens.edu).
# Set to "true" ONLY on preview/demo deployments. Leave unset in production.
ENABLE_DEMO_ACCOUNTS="false"
